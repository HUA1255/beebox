# ==== Console (console/): Vite/React build output and Playwright artifacts ====
console/node_modules/
# The built console is committed on purpose: a fresh production install serves
# /console from <app>\console\dist without Node on the host. Rebuild it with
# `cd console && npm ci && npm run build` and commit the result.
!console/dist/
console/dist/*
!console/dist/*
console/test-results/
console/playwright-report/
console/blob-report/
console/playwright/.cache/
