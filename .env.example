# BeeBox 本机服务环境变量示例。
# 复制为 .env 或直接导出；服务本身不会自动读取 .env 文件。
# 所有变量都可省略，省略时使用括号中的默认值。

# 固定安装根目录；Windows 服务安装脚本写入 C:/BeeBox。
# 设置后未显式给出的日志目录默认为 <root>/logs。
# BEEBOX_ROOT=C:/BeeBox

# 数据根目录：数据库、上传、派生音频、导出与缓存都放在这里。（默认：仓库下的 data/）
BEEBOX_DATA_DIR=D:/beebox-data

# 可选 Bearer token；设置后除 /v1/health 与 /console 外的接口都需要鉴权。（默认：空）
BEEBOX_API_TOKEN=

# 模型与框架缓存的存储根。（默认：与数据根相同）
# BEEBOX_MODEL_STORAGE_ROOT=D:/beebox-models

# 额外的允许模型存储根（逗号分隔）。
# BEEBOX_MODEL_STORAGE_ROOTS=D:/beebox-models

# 可选：锁定托管上传目录与派生音频目录；环境变量优先级最高。
# BEEBOX_UPLOADS_DIR=D:/beebox-data/uploads
# BEEBOX_DERIVED_AUDIO_DIR=D:/beebox-data/derived-audio

# 转写成功后删除派生音频。（默认：1，开启）
# BEEBOX_DELETE_DERIVED_ON_COMPLETE=1

# 任务与结果保留天数；过期后由服务内定时清理任务、结果与残留媒体。（默认：30）
# BEEBOX_RETENTION_DAYS=30

# B 站登录与每日刷新：real 使用 bilibili-api（扫码 + 自动续期）；fake 不联网，
# 供测试与本地冒烟使用。刷新失败或登录失效时 /v1/health 的 bilibili_login 为 expired。
# BEEBOX_BILIBILI_LOGIN=real
# BEEBOX_BILIBILI_LOGIN_FAKE={"states":["pending","scanned","confirmed"],"cookies":{"SESSDATA":"..."}}
# BEEBOX_BILIBILI_REFRESH=real
# BEEBOX_BILIBILI_REFRESH_FAKE={"outcome":"valid"}
# 每日检查间隔（秒）；可在冒烟时调小。（默认：86400）
# BEEBOX_BILIBILI_REFRESH_INTERVAL_SECONDS=86400

# 可选：强制对齐与说话人分离模型目录。
# BEEBOX_ALIGNER_MODEL_DIR=D:/beebox-models/qwen3-forced-aligner-0.6b
# BEEBOX_DIARIZATION_MODEL_DIR=D:/beebox-models/pyannote-community-1

# UTF-8 日志目录；未设置时为 <BEEBOX_ROOT>/logs，再退回 <BEEBOX_DATA_DIR>/logs。
# BEEBOX_LOG_DIR=C:/BeeBox/logs
# 日志按大小轮转：单文件字节数与保留备份数。（默认：10 MiB、5）
# BEEBOX_LOG_MAX_BYTES=10485760
# BEEBOX_LOG_BACKUP_COUNT=5
# 设为 0 可关闭控制台日志（Windows 服务安装脚本仍保留，stdout/stderr 由 WinSW 收集）。
# BEEBOX_LOG_CONSOLE=1

# 固定工具目录；未设置时为 <BEEBOX_ROOT>/tools。
# BEEBOX_TOOLS_DIR=C:/BeeBox/tools

# 可选：ffmpeg / ffprobe / Deno 可执行文件路径。
# 解析顺序：手动路径 → 下面的环境变量 → <BEEBOX_TOOLS_DIR> 固定布局 → PATH。
# 工具目录布局：tools/ffmpeg/bin/ffmpeg.exe、tools/ffmpeg/bin/ffprobe.exe、tools/deno/deno.exe。
# BEEBOX_FFMPEG_PATH=C:/BeeBox/tools/ffmpeg/bin/ffmpeg.exe
# BEEBOX_FFPROBE_PATH=C:/BeeBox/tools/ffmpeg/bin/ffprobe.exe
# BEEBOX_DENO_PATH=C:/BeeBox/tools/deno/deno.exe

# 上传限制：单文件字节数、批量文件数、批量总字节数。
# 默认：20 GiB、32 个文件、40 GiB。
# BEEBOX_MAX_UPLOAD_BYTES=21474836480
# BEEBOX_MAX_BATCH_FILES=32
# BEEBOX_MAX_BATCH_TOTAL_BYTES=42949672960

# 单次 ffmpeg/ffprobe 进程超时（秒）。（默认：按媒体时长估算，未知时长 21600 秒）
# BEEBOX_MEDIA_PROCESS_TIMEOUT_SECONDS=21600

# 本地转写 worker 无进度超时（秒）。（默认：1200）
# BEEBOX_LOCAL_WORKER_STALL_SECONDS=1200

# 开发/测试：1 表示在 API 进程内直接执行本地转写，不另起 worker。
# BEEBOX_INLINE_LOCAL_TRANSCRIPTION=1

# 语音引擎：local 使用真实 ASR/pyannote 模型；fake 返回脚本化结果，用于无模型测试。
# （默认：local）
# BEEBOX_SPEECH_ENGINE=local
# fake 引擎的脚本：segments/text/language/duration/aligned/speakers/
# diarization/fail 均可配置；fail 支持按 chunk_index 在分块中途失败。
# BEEBOX_SPEECH_FAKE_RESULT={"segments":[{"start":0,"end":1,"text":"hello"}]}
