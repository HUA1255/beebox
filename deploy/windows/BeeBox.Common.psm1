# Shared helpers for the BeeBox Windows deployment scripts.
# Windows PowerShell 5.1 and PowerShell 7 compatible: no ternary operator,
# no null-coalescing operator, no Get-Content -AsHashtable.

Set-StrictMode -Version 2.0

function Write-Step {
    param([string]$Message)
    Write-Host "==> $Message" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Message)
    Write-Host "    $Message" -ForegroundColor Green
}

function Write-Warn {
    param([string]$Message)
    Write-Host "    WARNING: $Message" -ForegroundColor Yellow
}

function Write-Info {
    param([string]$Message)
    Write-Host "    $Message"
}

function Write-DryRun {
    param([string]$Message)
    Write-Host "    [dry-run] $Message" -ForegroundColor DarkGray
}

function Resolve-FullPath {
    param(
        [Parameter(Mandatory = $true)][string]$Path,
        [string]$BasePath = (Get-Location).Path
    )
    if ([System.IO.Path]::IsPathRooted($Path)) {
        return [System.IO.Path]::GetFullPath($Path)
    }
    return [System.IO.Path]::GetFullPath((Join-Path $BasePath $Path))
}

function Test-IsAdministrator {
    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object System.Security.Principal.WindowsPrincipal($identity)
    return $principal.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Assert-Administrator {
    if (-not (Test-IsAdministrator)) {
        throw 'This installer must run from an elevated Windows PowerShell prompt (Run as administrator).'
    }
}

function New-BeeBoxToken {
    $bytes = New-Object byte[] 32
    $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
    try {
        $rng.GetBytes($bytes)
    }
    finally {
        $rng.Dispose()
    }
    return [Convert]::ToBase64String($bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_')
}

function Test-BeeBoxPathQuiet {
    <#
    .SYNOPSIS
        Test a path without letting an ACL denial abort the caller.
    .DESCRIPTION
        Windows PowerShell 5.1 raises ItemExistsUnauthorizedAccessError when
        probing a protected path; with $ErrorActionPreference = 'Stop' that
        becomes terminating. Callers that support "unreadable means absent"
        (the production settings probe in dev-instance.ps1) need a plain bool.
    #>
    param(
        [Parameter(Mandatory = $true)][string]$Path,
        [Parameter(Mandatory = $true)][ValidateSet('Leaf', 'Container', 'Any')][string]$PathType
    )
    try {
        return (Test-Path -LiteralPath $Path -PathType $PathType -ErrorAction Stop)
    }
    catch {
        return $false
    }
}

function Read-BeeBoxEnvFile {
    param([Parameter(Mandatory = $true)][string]$Path)

    $values = [ordered]@{}
    if (-not (Test-BeeBoxPathQuiet -Path $Path -PathType Leaf)) {
        return $values
    }
    try {
        $lines = Get-Content -LiteralPath $Path -Encoding UTF8 -ErrorAction Stop
    }
    catch {
        # An ACL-protected settings file behaves like an absent one: callers
        # already handle "token unknown" and "model root unknown".
        return $values
    }
    foreach ($line in $lines) {
        $trimmed = $line.Trim()
        if (-not $trimmed -or $trimmed.StartsWith('#')) {
            continue
        }
        $separator = $trimmed.IndexOf('=')
        if ($separator -lt 1) {
            continue
        }
        $key = $trimmed.Substring(0, $separator).Trim()
        $value = $trimmed.Substring($separator + 1).Trim()
        if ($value.Length -ge 2) {
            $quoted = ($value.StartsWith('"') -and $value.EndsWith('"')) -or ($value.StartsWith("'") -and $value.EndsWith("'"))
            if ($quoted) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }
        $values[$key] = $value
    }
    return $values
}

function Write-BeeBoxEnvFile {
    param(
        [Parameter(Mandatory = $true)][string]$Path,
        [Parameter(Mandatory = $true)][System.Collections.Specialized.OrderedDictionary]$Values,
        [string]$Header = 'BeeBox machine settings. Generated by deploy/windows/install.ps1. Do not commit this file.'
    )

    $lines = New-Object System.Collections.Generic.List[string]
    $lines.Add("# $Header")
    foreach ($key in $Values.Keys) {
        $lines.Add("$key=$($Values[$key])")
    }
    $text = ($lines -join [Environment]::NewLine) + [Environment]::NewLine
    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($Path, $text, $utf8NoBom)
}

function ConvertTo-XmlEscaped {
    param([string]$Value)
    if ($null -eq $Value) {
        return ''
    }
    return $Value.Replace('&', '&amp;').Replace('<', '&lt;').Replace('>', '&gt;').Replace('"', '&quot;').Replace("'", '&apos;')
}

function Write-BeeBoxServiceXml {
    param(
        [Parameter(Mandatory = $true)][string]$TemplatePath,
        [Parameter(Mandatory = $true)][string]$Destination,
        [Parameter(Mandatory = $true)][System.Collections.Specialized.OrderedDictionary]$SettingsValues,
        [Parameter(Mandatory = $true)][string]$PythonPath,
        [Parameter(Mandatory = $true)][string]$Arguments,
        [Parameter(Mandatory = $true)][string]$WorkingDirectory,
        [Parameter(Mandatory = $true)][string]$LogDirectory,
        [Parameter(Mandatory = $true)][string]$ServiceId,
        [Parameter(Mandatory = $true)][string]$DisplayName
    )

    $template = Get-Content -LiteralPath $TemplatePath -Raw -Encoding UTF8
    $envLines = New-Object System.Collections.Generic.List[string]
    foreach ($key in $SettingsValues.Keys) {
        $envLines.Add('  <env name="' + (ConvertTo-XmlEscaped $key) + '" value="' + (ConvertTo-XmlEscaped ([string]$SettingsValues[$key])) + '"/>')
    }
    $xml = $template
    $xml = $xml.Replace('{{SERVICE_ID}}', (ConvertTo-XmlEscaped $ServiceId))
    $xml = $xml.Replace('{{SERVICE_NAME}}', (ConvertTo-XmlEscaped $DisplayName))
    $xml = $xml.Replace('{{SERVICE_DESCRIPTION}}', (ConvertTo-XmlEscaped 'BeeBox local speech transcription service (automatic start, crash restart)'))
    $xml = $xml.Replace('{{PYTHON_EXE}}', (ConvertTo-XmlEscaped $PythonPath))
    $xml = $xml.Replace('{{SERVER_ARGUMENTS}}', (ConvertTo-XmlEscaped $Arguments))
    $xml = $xml.Replace('{{WORKING_DIRECTORY}}', (ConvertTo-XmlEscaped $WorkingDirectory))
    $xml = $xml.Replace('{{LOG_DIRECTORY}}', (ConvertTo-XmlEscaped $LogDirectory))
    $xml = $xml.Replace('{{SERVICE_ENV}}', ($envLines -join [Environment]::NewLine))

    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($Destination, $xml, $utf8NoBom)
}

function Invoke-BeeBoxNativeCapture {
    <#
    .SYNOPSIS
        Run a native command and capture stdout and stderr as text.
    .DESCRIPTION
        PowerShell 5.1 wraps native stderr lines in NativeCommandError; under
        $ErrorActionPreference = 'Stop' that aborts the script even when the
        command succeeded (git fetch prints "From ...", uv prints progress).
        Redirect stderr to a temporary file so it never enters the error stream.
    #>
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [string[]]$Arguments = @(),
        [string]$WorkingDirectory
    )

    $stderrFile = [System.IO.Path]::GetTempFileName()
    $pushed = $false
    $previousEap = $ErrorActionPreference
    try {
        if ($WorkingDirectory) {
            Push-Location -LiteralPath $WorkingDirectory
            $pushed = $true
        }
        # Redirection alone does not stop PS 5.1 from raising
        # NativeCommandError under $ErrorActionPreference = 'Stop'; relax it
        # for the call and restore it before returning.
        $ErrorActionPreference = 'Continue'
        $stdout = & $FilePath @Arguments 2> $stderrFile
        $exitCode = $LASTEXITCODE
        if ($null -eq $exitCode) {
            $exitCode = 0
        }
        $stderr = @(Get-Content -LiteralPath $stderrFile -ErrorAction SilentlyContinue)
        $text = (@($stdout) + $stderr | ForEach-Object { [string]$_ }) -join [Environment]::NewLine
        return [pscustomobject]@{
            ExitCode = $exitCode
            Text     = $text.Trim()
        }
    }
    finally {
        $ErrorActionPreference = $previousEap
        if ($pushed) {
            Pop-Location
        }
        Remove-Item -LiteralPath $stderrFile -Force -ErrorAction SilentlyContinue
    }
}

function Invoke-NativeCommand {
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [string[]]$Arguments = @(),
        [string]$WorkingDirectory,
        [hashtable]$Environment = @{}
    )

    $previous = @{}
    foreach ($key in $Environment.Keys) {
        $previous[$key] = [Environment]::GetEnvironmentVariable($key, 'Process')
        [Environment]::SetEnvironmentVariable($key, [string]$Environment[$key], 'Process')
    }
    $pushed = $false
    $stderrFile = [System.IO.Path]::GetTempFileName()
    $previousEap = $ErrorActionPreference
    try {
        if ($WorkingDirectory) {
            Push-Location -LiteralPath $WorkingDirectory
            $pushed = $true
        }
        $ErrorActionPreference = 'Continue'
        & $FilePath @Arguments 2> $stderrFile
        $exitCode = $LASTEXITCODE
        if ($null -eq $exitCode) {
            $exitCode = 0
        }
        $stderr = (@(Get-Content -LiteralPath $stderrFile -ErrorAction SilentlyContinue) -join [Environment]::NewLine).Trim()
        if ($stderr) {
            Write-Host $stderr
        }
        if ($exitCode -ne 0) {
            throw "Command failed with exit code ${exitCode}: $FilePath $($Arguments -join ' ')$([Environment]::NewLine)$stderr"
        }
    }
    finally {
        $ErrorActionPreference = $previousEap
        if ($pushed) {
            Pop-Location
        }
        Remove-Item -LiteralPath $stderrFile -Force -ErrorAction SilentlyContinue
        foreach ($key in $Environment.Keys) {
            [Environment]::SetEnvironmentVariable($key, $previous[$key], 'Process')
        }
    }
}

function Test-PathWritable {
    param([Parameter(Mandatory = $true)][string]$Path)
    try {
        if (-not (Test-Path -LiteralPath $Path -PathType Container)) {
            return $false
        }
        $probe = Join-Path $Path ('.beebox-write-probe-' + [Guid]::NewGuid().ToString('N'))
        $stream = [System.IO.File]::Create($probe)
        $stream.Dispose()
        Remove-Item -LiteralPath $probe -Force -ErrorAction SilentlyContinue
        return $true
    }
    catch {
        return $false
    }
}

function Set-PrivateDirectoryAcl {
    param([Parameter(Mandatory = $true)][string]$Path)

    # Locale-independent builtin SIDs: SYSTEM and Administrators. The service
    # runs as LocalSystem, so this is enough for it to read the token while
    # normal users cannot.
    & icacls.exe $Path /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' '/T' '/C' | Out-Null
    if ($LASTEXITCODE -ne 0) {
        throw "Failed to restrict permissions on $Path (icacls exit code $LASTEXITCODE)."
    }
    # icacls does not apply (OI)(CI) rights to plain files; with /inheritance:r
    # they would be left with an empty DACL (not even SYSTEM could read them).
    foreach ($file in @(Get-ChildItem -LiteralPath $Path -Recurse -File -ErrorAction SilentlyContinue)) {
        & icacls.exe $file.FullName /grant:r '*S-1-5-18:F' '*S-1-5-32-544:F' '/C' | Out-Null
        if ($LASTEXITCODE -ne 0) {
            throw "Failed to grant access to $($file.FullName) (icacls exit code $LASTEXITCODE)."
        }
    }
}

function Get-InstalledService {
    param([Parameter(Mandatory = $true)][string]$Name)
    return Get-Service -Name $Name -ErrorAction SilentlyContinue
}

function Wait-ServiceState {
    param(
        [Parameter(Mandatory = $true)][string]$Name,
        [Parameter(Mandatory = $true)][string]$State,
        [int]$TimeoutSeconds = 60
    )
    $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
    while ((Get-Date) -lt $deadline) {
        $service = Get-InstalledService -Name $Name
        if ($null -eq $service) {
            if ($State -eq 'Missing') {
                return $true
            }
            Start-Sleep -Milliseconds 500
            continue
        }
        if ($service.Status.ToString() -eq $State) {
            return $true
        }
        Start-Sleep -Milliseconds 500
    }
    return $false
}

Export-ModuleMember -Function *
